# ===========================================
# REQUIRED - No defaults, must be set
# ===========================================

# Storage credentials (must match main backend)
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Storage bucket prefix (must match main backend exactly - leave empty if main backend has no prefix)
STORAGE_BUCKET_PREFIX=


# ===========================================
# DOCKER SERVICES - Required for docker-compose
# These are used by Docker services directly
# Set appropriate values or keep defaults
# ===========================================

# Project
COMPOSE_PROJECT_NAME=teledash-processing

# Network (must match main backend's COMPOSE_PROJECT_NAME + _default if on same machine)
TELEDASH_DOCKER_NETWORK=teledash_default

# Elasticsearch (must match main backend settings)
ELASTIC_HOST=elastic  # same docker network: container name, different machines: IP/URL without http
ELASTIC_PORT=9200

# Redis (ensure no conflict with main backend if on same machine)
REDIS_PORT=6379

# GPU Configuration
GPU_USE=false
GPU_DEVICE=0  # Which GPU to use (0, 1, 2, etc.)

# API Ports (ensure no conflicts if on same machine as main backend)
TEXT_FAST_API_PORT=8001
IMAGE_FAST_API_PORT=8002


# ===========================================
# OPTIONAL - Python application settings
# Uncomment to override defaults in settings.py
# See README.md for complete documentation
# ===========================================

# --- Model Loading ---
#LOAD_MODELS_FROM_HUGGINGFACE=true

# --- Classification ---
#CLASSIFICATION_MODEL=digitaler-hass/TelConGBERT
#CLASSIFICATION_FIELDS=["text","caption"]
#CLASSIFICATION_MIN_CHAR_LENGTH=50
#CLASSIFICATION_FETCH_BATCH_SIZE=265  # Batch size for how many messages to retrieve from database at once
#CLASSIFICATION_LANGUAGES=["de"]  # TelConGBERT only works for German language
#CLASSIFICATION_INTERVAL_MINUTES=120

# --- ASR (Transcription) ---
#ASR_MODEL=medium
#ASR_VAD_FILTER=true
#ASR_ATTACHMENT_TYPES=["audio","voice"]
#ASR_CONCURRENCY=1
#ASR_INTERVAL_MINUTES=60

# --- Storage Provider ---
#STORAGE_PROVIDER=s3-compatible
#STORAGE_REGION=
#STORAGE_USE_SSL=false
#STORAGE_VERIFY_SSL=true  # set false to skip TLS cert verification (self-signed endpoints, e.g. NAS)
#STORAGE_ENDPOINT=minio:9000
# Note: STORAGE_BUCKET_PREFIX is in REQUIRED section above - must match main backend

# --- Semantic Text Search ---
#TEXT_EMBEDDING_MODEL=Sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
#TEXT_EMBEDDING_DIMENSION=384  # Check model configuration
#TEXT_EMBEDDING_FIELDS=["text","caption"]
#TEXT_EMBEDDING_FETCH_BATCH_SIZE=256  # Batch size for how many messages to retrieve from database at once
#TEXT_EMBEDDING_MODEL_BATCH_SIZE=32  # Batch size for embedding model, adjust based on your hardware
#TEXT_EMBEDDINGS_INTERVAL_MINUTES=30

# --- Semantic Image Search ---
#IMAGE_EMBEDDING_MODEL=openai/clip-vit-base-patch16
#IMAGE_EMBEDDING_DIMENSION=512  # Auto-set based on model
#IMAGE_ATTACHMENT_TYPES=["photo"]  # For now image only. Later maybe videos through keyframes
#IMAGE_EMBEDDING_MODEL_BATCH_SIZE=4  # Adjust based on your hardware, e.g. 8, 16 or 64
#IMAGE_FETCH_BATCH_SIZE=128  # Batch size for how many messages with image attachments to retrieve at once
#IMAGE_EMBEDDING_INTERVAL_MINUTES=30
