{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Celery worker (image embedding)",
      "type": "debugpy",
      "request": "launch",
      "module": "celery",
      "console": "integratedTerminal",
      "args": [
        "--app=main",
        "worker",
        "--loglevel=INFO",
        "--pool=threads",
        "--queues=image-embeddings",
        "--concurrency=1",
        "--hostname=image-embedding-worker@%h",
      ],
    },
  ]
}